@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_mach_saved_prefix_path "${CMAKE_PREFIX_PATH}")

list(PREPEND CMAKE_PREFIX_PATH
    "${PACKAGE_PREFIX_DIR}/vcpkg_installed/@MACH_VCPKG_TRIPLET@"
)

find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(fmt CONFIG REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)

set(CMAKE_PREFIX_PATH "${_mach_saved_prefix_path}")
unset(_mach_saved_prefix_path)

include("${CMAKE_CURRENT_LIST_DIR}/MachTargets.cmake")

check_required_components(Mach)
